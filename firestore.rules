rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // v3.3.0: Google sign-in needs Firebase's public sign-up switched ON, which lets bots create password accounts.
    // This rule is what keeps them out: only accounts with a CONFIRMED email may use the database.
    // Google accounts and accounts created by the OTP Worker are always confirmed; a bot-made account never is.
    // Set requireVerifiedEmail() to false only if you keep Firebase's public sign-up switched OFF (and then Google sign-in cannot create new users).
    function requireVerifiedEmail() { return true; }
    function signedIn() {
      return request.auth != null && (!requireVerifiedEmail() || request.auth.token.email_verified == true);
    }

    function evData(eid) { return get(/databases/$(database)/documents/events/$(eid)).data; }
    function isMember(eid) { return signedIn() && request.auth.uid in evData(eid).memberIds; }
    function role(eid) { return evData(eid).members[request.auth.uid].role; }
    function isStaff(eid) { return isMember(eid) && role(eid) in ['owner','organizer','manager','treasurer']; }
    function isWriter(eid) { return isMember(eid) && role(eid) in ['owner','organizer','manager','treasurer','lead','member']; }
    function formData(fid) { return get(/databases/$(database)/documents/payforms/$(fid)).data; }
    function seesForm(fid) { return signedIn() && (formData(fid).by == request.auth.uid || isStaff(formData(fid).eid)); }

    // Chat text is either a plain string (max 1000 chars) or deflate-compressed bytes flagged with c == 1.
    function chatTextOk(d) {
      return (d.t is string && d.t.size() > 0 && d.t.size() <= 1000 && !('c' in d))
          || (d.t is bytes && d.t.size() > 0 && d.t.size() <= 4000 && 'c' in d && d.c == 1);
    }

    // v3.1.0: @mentions. Optional list 'm' of member ids (max 20), every id must belong to a member of this event.
    function mentionOk(eid, d) {
      return !('m' in d) || (d.m is list && d.m.size() > 0 && d.m.size() <= 20
        && d.m.toSet().difference(evData(eid).memberIds.toSet()).size() == 0);
    }

    // v3.1.0: a payment link is live only while its event still exists AND the expiry time ('until', ms) has not passed.
    // Links created before 3.1.0 have no 'until'; they stay live until the app stamps one on them (see SETUP.md).
    function liveForm(d) {
      return exists(/databases/$(database)/documents/events/$(d.eid))
        && d.get('until', 99999999999999) > request.time.toMillis();
    }

    // A non-member may only add THEMSELVES as a plain 'member'. Nothing else may change.
    function joinOk() {
      let n = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return n.diff(o).affectedKeys().hasOnly(['members','memberIds'])
        && n.memberIds.toSet().difference(o.memberIds.toSet()) == [me].toSet()
        && o.memberIds.toSet().difference(n.memberIds.toSet()).size() == 0
        && n.members.diff(o.members).affectedKeys() == [me].toSet()
        && n.members[me].keys().hasOnly(['name','role'])
        && n.members[me].role == 'member'
        && n.members[me].name is string;
    }

    match /events/{id} {
      // Private: only organiser and joined members can read an event.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds || joinOk());
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // Event chat (v2.0.0). Members read everything, including messages sent before they joined.
      match /chat/{mid} {
        allow read: if isMember(id);

        // Only a member who may write (not a viewer) can post, only as themselves, with their own member name.
        // 'at' must be the server's time, so nobody can fake or back-date a message.
        allow create: if isWriter(id)
          && request.resource.data.keys().hasOnly(['u','n','t','at','c','m'])
          && request.resource.data.u == request.auth.uid
          && request.resource.data.n == evData(id).members[request.auth.uid].name
          && request.resource.data.at == request.time
          && chatTextOk(request.resource.data)
          && mentionOk(id, request.resource.data);

        // Own messages can be edited for 2 hours after they were sent.
        allow update: if isWriter(id)
          && resource.data.u == request.auth.uid
          && request.time < resource.data.at + duration.value(2, 'h')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t','c','ed','m'])
          && request.resource.data.ed == request.time
          && chatTextOk(request.resource.data)
          && mentionOk(id, request.resource.data);

        // Own messages can be deleted for 2 hours. Organizer and managers can delete any message at any time
        // (moderation, and clearing the chat when the event is deleted).
        allow delete: if isMember(id) && (
          (resource.data.u == request.auth.uid && request.time < resource.data.at + duration.value(2, 'h'))
          || role(id) in ['owner','organizer','manager']);
      }
    }

    // Public payment links: anyone with the link can open the form and submit details, but only while the link is live
    // (its event exists and the expiry time has not passed). Organizers and the link's creator can always read it.
    match /payforms/{fid} {
      allow get: if resource == null
        || liveForm(resource.data)
        || (signedIn() && (resource.data.by == request.auth.uid || isStaff(resource.data.eid)));
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && isWriter(request.resource.data.eid)
        && request.resource.data.until is number;
      allow update: if signedIn()
        && (resource.data.by == request.auth.uid || isStaff(resource.data.eid))
        && request.resource.data.eid == resource.data.eid
        && request.resource.data.by == resource.data.by
        && request.resource.data.until is number;
      allow delete: if signedIn()
        && (resource.data.by == request.auth.uid || isStaff(resource.data.eid));

      match /subs/{sid} {
        // Payers need no account. The document id is the UTR, so a UTR can be submitted only once. Closed once the link expires or the event is deleted.
        allow create: if request.resource.data.keys().hasOnly(['n','a','utr','s','at'])
          && request.resource.data.n is string
          && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 80
          && request.resource.data.a is number
          && request.resource.data.a > 0 && request.resource.data.a <= 10000000
          && request.resource.data.utr is string
          && request.resource.data.utr.matches('[A-Z0-9]{6,40}')
          && request.resource.data.utr == sid
          && request.resource.data.s == 'pending'
          && request.resource.data.at is number
          && exists(/databases/$(database)/documents/payforms/$(fid))
          && liveForm(formData(fid));
        allow get, list: if seesForm(fid);
        allow update: if seesForm(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s'])
          && request.resource.data.s in ['pending','verified','rejected'];
        allow delete: if seesForm(fid);
      }
    }

    // App version control: everyone can read, nobody can write from the app. Edit this doc in the Firebase console.
    match /appconfig/{id} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
